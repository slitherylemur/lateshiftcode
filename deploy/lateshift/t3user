#!/usr/bin/env bash
# t3user - LateShift Cloud per-user T3 Code instance provisioning CLI.
#
# Usage:
#   t3user add <name> [--project-limit N] [--admin]   provision + start an instance
#   t3user remove <name> [--force]                    stop instance, archive its data
#   t3user list                                       show all registered users
#   t3user set <name> <key> <value>                   update a registry field
#                                                     (keys: projectLimit, admin, githubLogin)
#   t3user pair <name> [--ttl 1h]                     mint a one-time pairing URL
#
# State lives under /home/dev/services/lateshift:
#   users.json           port/user registry (contract consumed by the portal)
#   users/<name>/        per-user T3 base dir (all instance state under userdata/)
#   users/<name>/instance.env   ports + limits consumed by t3code@<name>.service
#   archive/             timestamped archives of removed users (never deleted)
#
# SAFETY: this tool only ever manages t3code@<name> template units. It must
# never touch the plain `t3code.service` production unit or HTTPS port 443.
set -euo pipefail

LATESHIFT_ROOT="/home/dev/services/lateshift"
REGISTRY="${LATESHIFT_ROOT}/users.json"
USERS_DIR="${LATESHIFT_ROOT}/users"
ARCHIVE_DIR="${LATESHIFT_ROOT}/archive"
LOCK_FILE="${LATESHIFT_ROOT}/.registry.lock"
PUBLIC_DOMAIN="lateshiftcloud.com"   # public gateway domain
RENDER_GATEWAY="${LATESHIFT_ROOT}/bin/render-gateway"  # regenerate Caddy user blocks
T3_CLI="/usr/bin/t3"
HEALTH_TIMEOUT_SECS=60
RESERVED_LOCAL_PORT=3773   # production t3code local port

die() { echo "t3user: $*" >&2; exit 1; }

usage() {
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# Normalize a port to a canonical decimal integer: strips one leading '+' and
# leading zeros, requires digits only, range 1-65535. Prints the normalized
# value; fails otherwise. Every port read from the registry, env, or CLI must
# pass through this before comparison or use, so "0443"/"+443" cannot bypass
# the reserved-port guards.
normalize_port() {
    local raw="$1" v
    v="${raw#+}"
    [[ "${v}" =~ ^[0-9]+$ ]] || { echo "t3user: invalid port '${raw}': not a positive integer" >&2; return 1; }
    v=$((10#${v}))
    (( v >= 1 && v <= 65535 )) || { echo "t3user: invalid port '${raw}': out of range 1-65535" >&2; return 1; }
    echo "${v}"
}

ensure_registry() {
    mkdir -p "${USERS_DIR}" "${ARCHIVE_DIR}"
    if [[ ! -f "${REGISTRY}" ]]; then
        cat > "${REGISTRY}" <<'EOF'
{
  "users": {},
  "nextLocalPort": 3780
}
EOF
    fi
}

validate_name() {
    local name="$1"
    [[ "${name}" =~ ^[a-z0-9-]{2,20}$ ]] || die "invalid name '${name}' (allowed: [a-z0-9-]{2,20})"
    # Reserved words that could collide with the production unit or tooling.
    case "${name}" in
        t3code|production|prod|lateshift) die "name '${name}' is reserved" ;;
    esac
}

# registry_py <op> [args...]  -- all registry access goes through python3 (no jq
# on box). Writes are atomic: temp file in the same directory, fsync, rename.
registry_py() {
    python3 - "$@" <<'PYEOF'
import json, os, sys, datetime, tempfile

REGISTRY = "/home/dev/services/lateshift/users.json"
RESERVED_LOCAL = {3773}
op = sys.argv[1]
args = sys.argv[2:]

with open(REGISTRY) as f:
    reg = json.load(f)

def save():
    # Crash-safe write: temp file in same dir -> fsync -> atomic rename.
    reg_dir = os.path.dirname(REGISTRY)
    fd, tmp = tempfile.mkstemp(prefix="users.json.tmp.", dir=reg_dir)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(reg, f, indent=2, sort_keys=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.rename(tmp, REGISTRY)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    # Persist the rename itself.
    dfd = os.open(reg_dir, os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)

def taken():
    return {int(u["localPort"]) for u in reg["users"].values()}

def parse_busy(s):
    out = set()
    for tok in s.split(","):
        tok = tok.strip()
        if tok.isdigit():
            out.add(int(tok))
    return out

if op == "exists":
    sys.exit(0 if args[0] in reg["users"] else 1)

elif op == "alloc":
    # alloc <busy_local_csv>
    # Pick the next free local port WITHOUT persisting anything. The caller
    # holds the registry flock for the whole `add`, so the port stays reserved
    # until `commit` (or is simply dropped on failure, leaving no state).
    busy_local = parse_busy(args[0]) | taken() | RESERVED_LOCAL
    def pick(start, busy):
        p = int(start)
        for _ in range(2000):
            if 1 <= p <= 65535 and p not in busy:
                return p
            p += 1
        print("no free port found within search window", file=sys.stderr)
        sys.exit(2)
    print(pick(reg["nextLocalPort"], busy_local))

elif op == "commit":
    # commit <name> <localPort> <projectLimit> <admin>
    # Persist a user AFTER its instance passed health checks.
    name, local_port = args[0], int(args[1])
    project_limit, admin = int(args[2]), args[3] == "true"
    if name in reg["users"]:
        print(f"user '{name}' already present at commit time", file=sys.stderr)
        sys.exit(1)
    if local_port in RESERVED_LOCAL:
        print("refusing to commit reserved production port", file=sys.stderr)
        sys.exit(2)
    reg["users"][name] = {
        "localPort": local_port,
        "baseDir": f"/home/dev/services/lateshift/users/{name}",
        "projectLimit": project_limit,
        "admin": admin,
        "githubLogin": None,
        "createdAt": datetime.datetime.now(datetime.timezone.utc)
            .strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    reg["nextLocalPort"] = max(reg["nextLocalPort"], local_port + 1)
    save()

elif op == "get":
    name, field = args[0], args[1]
    user = reg["users"].get(name)
    if user is None:
        sys.exit(1)
    print(user[field])

elif op == "remove":
    name = args[0]
    if name not in reg["users"]:
        sys.exit(1)
    del reg["users"][name]
    save()

elif op == "set":
    # set <name> <key> <value>
    # Allowed keys only; each value is validated here (defense in depth: the
    # bash wrapper validates too).
    name, key, value = args[0], args[1], args[2]
    user = reg["users"].get(name)
    if user is None:
        print(f"user '{name}' not found", file=sys.stderr)
        sys.exit(1)
    if key == "projectLimit":
        if not (value.isdigit() and 0 <= int(value) <= 999):
            print("projectLimit must be an integer 0-999", file=sys.stderr)
            sys.exit(2)
        user[key] = int(value)
    elif key == "admin":
        if value not in ("true", "false"):
            print(f"{key} must be 'true' or 'false'", file=sys.stderr)
            sys.exit(2)
        user[key] = value == "true"
    elif key == "githubLogin":
        import re
        if value == "":
            user[key] = None
        else:
            if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?", value):
                print(f"invalid githubLogin: {value}", file=sys.stderr)
                sys.exit(2)
            for other, u in reg["users"].items():
                if other != name and (u.get("githubLogin") or "").lower() == value.lower():
                    print(f"githubLogin already mapped to user: {other}", file=sys.stderr)
                    sys.exit(3)
            user[key] = value
    else:
        print(f"key '{key}' is not settable (allowed: projectLimit, admin, githubLogin)", file=sys.stderr)
        sys.exit(2)
    save()

elif op == "list":
    fmt = "{:<20} {:>9} {:>13} {:>6}  {:<28} {}"
    print(fmt.format("NAME", "LOCALPORT", "PROJECTLIMIT", "ADMIN", "GITHUBLOGIN", "CREATED"))
    for name, u in sorted(reg["users"].items()):
        print(fmt.format(name, u["localPort"], u["projectLimit"],
                         "yes" if u["admin"] else "no",
                         u.get("githubLogin") or "-", u["createdAt"]))

else:
    print(f"unknown registry op: {op}", file=sys.stderr)
    sys.exit(2)
PYEOF
}

# CSV of local TCP ports currently in LISTEN state.
listening_ports_csv() {
    ss -ltnH 2>/dev/null | awk '{print $4}' | awk -F: '{print $NF}' \
        | grep -E '^[0-9]+$' | sort -un | paste -sd, - || true
}

wait_for_health() {
    local name="$1" port="$2" deadline=$((SECONDS + HEALTH_TIMEOUT_SECS)) code
    while (( SECONDS < deadline )); do
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:${port}/" || true)
        if [[ "${code}" == "200" ]] && [[ "$(systemctl is-active "t3code@${name}.service" 2>/dev/null)" == "active" ]]; then
            echo "healthy (HTTP ${code} on 127.0.0.1:${port}, unit active)"
            return 0
        fi
        sleep 2
    done
    return 1
}

# Confirm the process listening on <port> belongs to the t3code@<name> unit's
# cgroup. Returns 0 on confirmed ownership, 0 with a warning if ownership
# cannot be determined (is-active + curl already passed), 1 on a confirmed
# foreign listener.
verify_unit_owns_port() {
    local name="$1" port="$2" listener_pid cgroup_procs
    listener_pid=$(ss -ltnpH "sport = :${port}" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1 || true)
    cgroup_procs="/sys/fs/cgroup/system.slice/system-t3code.slice/t3code@${name}.service/cgroup.procs"
    if [[ -z "${listener_pid}" || ! -r "${cgroup_procs}" ]]; then
        echo "warning: could not attribute listener on port ${port} to a cgroup; relying on is-active + HTTP checks" >&2
        return 0
    fi
    if grep -qx "${listener_pid}" "${cgroup_procs}"; then
        echo "listener pid ${listener_pid} confirmed inside t3code@${name}.service cgroup"
        return 0
    fi
    echo "port ${port} is served by pid ${listener_pid}, which is NOT in t3code@${name}.service's cgroup" >&2
    return 1
}

# Roll back a failed `add`: stop/disable the unit and delete the directory this
# invocation created. The registry was never touched (commit happens only after
# health), so nothing to undo there.
rollback_add() {
    local name="$1" created_dir="$2"
    echo "rolling back failed provision of '${name}' ..." >&2
    sudo systemctl disable --now "t3code@${name}.service" >/dev/null 2>&1 || true
    # Safe: this exact path was verified absent at the start of this add and
    # created by this invocation; the instance never became healthy.
    if [[ -n "${created_dir}" && -d "${created_dir}" ]]; then
        rm -rf "${created_dir}"
    fi
}

cmd_add() {
    local name="" project_limit=3 admin=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project-limit) project_limit="${2:?--project-limit needs a value}"; shift 2 ;;
            --admin) admin=true; shift ;;
            -*) die "unknown flag for add: $1" ;;
            *) [[ -n "${name}" ]] && die "unexpected argument: $1"; name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: t3user add <name> [--project-limit N] [--admin]"
    validate_name "${name}"
    [[ "${project_limit}" =~ ^[0-9]+$ ]] || die "--project-limit must be a number"

    if registry_py exists "${name}"; then
        die "user '${name}' already exists (refusing to re-add)"
    fi
    [[ -e "${USERS_DIR}/${name}" ]] && die "base dir ${USERS_DIR}/${name} already exists; resolve manually"

    # Allocate the local port (no registry write yet; the held flock reserves it
    # for the duration of this add). Skips listening ports, existing registry
    # entries, and production's 3773.
    local local_port
    local_port=$(registry_py alloc "$(listening_ports_csv)") || die "port allocation failed"
    local_port=$(normalize_port "${local_port}") || die "allocator returned bad local port"
    (( local_port != RESERVED_LOCAL_PORT )) || die "allocator returned reserved local port ${RESERVED_LOCAL_PORT}"

    local base_dir="${USERS_DIR}/${name}"
    mkdir -p "${base_dir}"
    cat > "${base_dir}/instance.env" <<EOF
# LateShift Cloud instance config for '${name}' (consumed by t3code@${name}.service)
T3CODE_INSTANCE_PORT=${local_port}
T3CODE_MAX_PROJECTS=${project_limit}
LSC_USER_NAME=${name}
EOF

    echo "provisioning '${name}': local port ${local_port}"
    if ! sudo systemctl enable --now "t3code@${name}.service"; then
        rollback_add "${name}" "${base_dir}"
        die "systemctl enable --now t3code@${name} failed; rolled back (registry untouched)"
    fi

    echo -n "waiting for health on 127.0.0.1:${local_port} ... "
    if ! wait_for_health "${name}" "${local_port}"; then
        echo "FAILED"
        echo "instance did not become healthy within ${HEALTH_TIMEOUT_SECS}s; recent logs:" >&2
        sudo journalctl -u "t3code@${name}" -n 20 --no-pager >&2 || true
        rollback_add "${name}" "${base_dir}"
        die "provision failed; rolled back (registry untouched)"
    fi
    if ! verify_unit_owns_port "${name}" "${local_port}"; then
        rollback_add "${name}" "${base_dir}"
        die "port ${local_port} answered but is not owned by t3code@${name}; rolled back (registry untouched)"
    fi

    # Instance is healthy and verified: persist it to the registry (atomic write).
    registry_py commit "${name}" "${local_port}" "${project_limit}" "${admin}" \
        || { rollback_add "${name}" "${base_dir}"; die "registry commit failed; rolled back"; }

    systemctl status "t3code@${name}" --no-pager -n 0 | head -6 || true
    echo
    echo "user '${name}' is up:"
    echo "  local:   http://127.0.0.1:${local_port}/"
    echo "  public:  https://${name}.${PUBLIC_DOMAIN}/"
    echo "  pair:    t3user pair ${name}"

    # Sync the public gateway's per-user Caddy blocks (best-effort; the tailnet
    # path above is already live regardless).
    sudo "${RENDER_GATEWAY}" >/dev/null 2>&1 || echo "warning: render-gateway failed; run 'sudo ${RENDER_GATEWAY}' to sync the public gateway" >&2
}

cmd_remove() {
    local name="" force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force) force=true; shift ;;
            -*) die "unknown flag for remove: $1" ;;
            *) [[ -n "${name}" ]] && die "unexpected argument: $1"; name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: t3user remove <name> [--force]"
    validate_name "${name}"
    registry_py exists "${name}" || die "user '${name}' not found"

    echo "stopping and disabling t3code@${name} ..."
    if ! sudo systemctl disable --now "t3code@${name}.service"; then
        if ${force}; then
            echo "warning: 'systemctl disable --now t3code@${name}' failed; continuing due to --force" >&2
        else
            die "failed to stop/disable t3code@${name}; aborting before archive/deregister (use --force to override)"
        fi
    fi

    # Clear any residual failed state so a removed user leaves no unit debris.
    sudo systemctl reset-failed "t3code@${name}.service" 2>/dev/null || true

    if [[ -d "${USERS_DIR}/${name}" ]]; then
        # Collision-safe archive destination: UTC timestamp + nanoseconds, and
        # hard-fail if it somehow already exists (never merge/nest archives).
        local dest="${ARCHIVE_DIR}/${name}-$(date -u +%Y%m%d-%H%M%S)-$(date +%N)"
        [[ -e "${dest}" ]] && die "archive destination ${dest} already exists; refusing to overwrite"
        mv -T "${USERS_DIR}/${name}" "${dest}"
        echo "archived base dir to ${dest}"
    fi

    registry_py remove "${name}"
    echo "user '${name}' removed (data archived, never deleted)"

    # Drop the removed user's block from the public gateway (best-effort).
    sudo "${RENDER_GATEWAY}" >/dev/null 2>&1 || echo "warning: render-gateway failed; run 'sudo ${RENDER_GATEWAY}' to sync the public gateway" >&2
}

cmd_list() {
    [[ $# -eq 0 ]] || die "list takes no arguments"
    registry_py list
}

# set <name> <key> <value> — update one registry field. For projectLimit the
# instance.env T3CODE_MAX_PROJECTS line is rewritten too. The caller must
# restart t3code@<name> for changes to take effect.
cmd_set() {
    [[ $# -eq 3 ]] || die "usage: t3user set <name> <key> <value>"
    local name="$1" key="$2" value="$3"
    validate_name "${name}"
    registry_py exists "${name}" || die "user '${name}' not found"

    case "${key}" in
        projectLimit)
            [[ "${value}" =~ ^[0-9]{1,3}$ ]] || die "projectLimit must be an integer 0-999"
            ;;
        admin)
            [[ "${value}" == "true" || "${value}" == "false" ]] || die "${key} must be 'true' or 'false'"
            ;;
        githubLogin)
            [[ -z "${value}" || "${value}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]] || die "invalid githubLogin"
            ;;
        *) die "key '${key}' is not settable (allowed: projectLimit, admin, githubLogin)" ;;
    esac

    registry_py set "${name}" "${key}" "${value}"

    if [[ "${key}" == "projectLimit" ]]; then
        local env_file
        env_file="$(registry_py get "${name}" baseDir)/instance.env"
        if [[ -f "${env_file}" ]]; then
            # Rewrite only the T3CODE_MAX_PROJECTS line; never touch the port
            # lines. Atomic replace within the same directory.
            local tmp
            tmp="$(mktemp "${env_file}.tmp.XXXXXX")"
            if grep -q '^T3CODE_MAX_PROJECTS=' "${env_file}"; then
                sed "s/^T3CODE_MAX_PROJECTS=.*/T3CODE_MAX_PROJECTS=${value}/" "${env_file}" > "${tmp}"
            else
                cat "${env_file}" > "${tmp}"
                echo "T3CODE_MAX_PROJECTS=${value}" >> "${tmp}"
            fi
            mv "${tmp}" "${env_file}"
            echo "updated ${env_file}; restart t3code@${name} to apply the new limit"
        else
            echo "warning: ${env_file} not found; registry updated but no instance.env to rewrite" >&2
        fi
    fi
    echo "set ${name}.${key} = ${value}"
}

cmd_pair() {
    local name="" ttl="1h"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ttl) ttl="${2:?--ttl needs a value}"; shift 2 ;;
            -*) die "unknown flag for pair: $1" ;;
            *) [[ -n "${name}" ]] && die "unexpected argument: $1"; name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: t3user pair <name> [--ttl 1h]"
    validate_name "${name}"
    registry_py exists "${name}" || die "user '${name}' not found"

    local base_dir base_url
    base_dir=$(registry_py get "${name}" baseDir)
    base_url="https://${name}.${PUBLIC_DOMAIN}"

    "${T3_CLI}" auth pairing create \
        --base-dir "${base_dir}" \
        --ttl "${ttl}" \
        --label "lateshift-${name}" \
        --base-url "${base_url}"
}

main() {
    [[ $# -ge 1 ]] || usage 1
    local cmd="$1"; shift
    case "${cmd}" in
        add|remove|pair|list|set)
            # Serialize ALL registry access (reads included) across concurrent
            # invocations; lock is taken before first-time registry creation.
            mkdir -p "${LATESHIFT_ROOT}"
            exec 9> "${LOCK_FILE}"
            flock 9
            ensure_registry
            "cmd_${cmd}" "$@"
            ;;
        -h|--help|help) usage 0 ;;
        *) die "unknown command '${cmd}' (try: add, remove, list, set, pair)" ;;
    esac
}

main "$@"
