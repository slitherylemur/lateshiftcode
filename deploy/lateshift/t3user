#!/usr/bin/env bash
# t3user - LateShift Cloud per-user T3 Code instance provisioning CLI.
#
# Usage:
#   t3user add <name> [--project-limit N] [--admin] [--ts-login LOGIN]
#                                                     provision + start an instance
#   t3user remove <name> [--force]                    stop instance, archive its data
#   t3user list                                       show all registered users
#   t3user set <name> <key> <value>                   update a registry field
#                                                     (keys: projectLimit, sharedAccess, tsLogin, admin, monthlyBudgetUsd)
#   t3user pair <name> [--ttl 1h]                     mint a one-time pairing URL
#   t3user share <name> <abs-path>                    grant a shared project dir (t3 project add on their instance)
#   t3user unshare <name> <abs-path>                  revoke a shared project dir
#
# State lives under /home/dev/services/lateshift:
#   users.json           port/user registry (contract consumed by the portal)
#   users/<name>/        per-user T3 base dir (all instance state under userdata/)
#   users/<name>/instance.env   ports + limits consumed by t3code@<name>.service
#   archive/             timestamped archives of removed users (never deleted)
#
# SAFETY: this tool only ever manages t3code@<name> template units. It must
# never touch the plain `t3code.service` production unit or HTTPS port 443.
set -euo pipefail

LATESHIFT_ROOT="/home/dev/services/lateshift"
REGISTRY="${LATESHIFT_ROOT}/users.json"
USERS_DIR="${LATESHIFT_ROOT}/users"
ARCHIVE_DIR="${LATESHIFT_ROOT}/archive"
LOCK_FILE="${LATESHIFT_ROOT}/.registry.lock"
TAILNET_HOST="t3cloud.taild7c97b.ts.net"
T3_CLI="/usr/bin/t3"
HEALTH_TIMEOUT_SECS=60
RESERVED_LOCAL_PORT=3773   # production t3code local port
RESERVED_TS_PORT=443       # production tailscale serve HTTPS port

die() { echo "t3user: $*" >&2; exit 1; }

usage() {
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# Normalize a port to a canonical decimal integer: strips one leading '+' and
# leading zeros, requires digits only, range 1-65535. Prints the normalized
# value; fails otherwise. Every port read from the registry, env, or CLI must
# pass through this before comparison or use, so "0443"/"+443" cannot bypass
# the reserved-port guards.
normalize_port() {
    local raw="$1" v
    v="${raw#+}"
    [[ "${v}" =~ ^[0-9]+$ ]] || { echo "t3user: invalid port '${raw}': not a positive integer" >&2; return 1; }
    v=$((10#${v}))
    (( v >= 1 && v <= 65535 )) || { echo "t3user: invalid port '${raw}': out of range 1-65535" >&2; return 1; }
    echo "${v}"
}

ensure_registry() {
    mkdir -p "${USERS_DIR}" "${ARCHIVE_DIR}"
    if [[ ! -f "${REGISTRY}" ]]; then
        cat > "${REGISTRY}" <<'EOF'
{
  "users": {},
  "nextLocalPort": 3780,
  "nextTsPort": 8460
}
EOF
    fi
}

validate_name() {
    local name="$1"
    [[ "${name}" =~ ^[a-z0-9-]{2,20}$ ]] || die "invalid name '${name}' (allowed: [a-z0-9-]{2,20})"
    # Reserved words that could collide with the production unit or tooling.
    case "${name}" in
        t3code|production|prod|lateshift) die "name '${name}' is reserved" ;;
    esac
}

# Tailnet login identity, e.g. "alice@github" or "alice@example.com".
validate_ts_login() {
    local login="$1"
    [[ "${login}" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]] \
        || die "invalid tsLogin '${login}' (expected user@domain, e.g. alice@github)"
    (( ${#login} <= 128 )) || die "tsLogin too long"
}

# registry_py <op> [args...]  -- all registry access goes through python3 (no jq
# on box). Writes are atomic: temp file in the same directory, fsync, rename.
registry_py() {
    python3 - "$@" <<'PYEOF'
import json, os, sys, datetime, tempfile

REGISTRY = "/home/dev/services/lateshift/users.json"
RESERVED_LOCAL = {3773}
RESERVED_TS = {443}
op = sys.argv[1]
args = sys.argv[2:]

with open(REGISTRY) as f:
    reg = json.load(f)

def save():
    # Crash-safe write: temp file in same dir -> fsync -> atomic rename.
    reg_dir = os.path.dirname(REGISTRY)
    fd, tmp = tempfile.mkstemp(prefix="users.json.tmp.", dir=reg_dir)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(reg, f, indent=2, sort_keys=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.rename(tmp, REGISTRY)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    # Persist the rename itself.
    dfd = os.open(reg_dir, os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)

def taken(kind):
    key = "localPort" if kind == "local" else "tsPort"
    return {int(u[key]) for u in reg["users"].values()}

def parse_busy(s):
    out = set()
    for tok in s.split(","):
        tok = tok.strip()
        if tok.isdigit():
            out.add(int(tok))
    return out

if op == "exists":
    sys.exit(0 if args[0] in reg["users"] else 1)

elif op == "alloc":
    # alloc <busy_local_csv> <busy_ts_csv>
    # Pick the next free port pair WITHOUT persisting anything. The caller
    # holds the registry flock for the whole `add`, so the pair stays reserved
    # until `commit` (or is simply dropped on failure, leaving no state).
    busy_local = parse_busy(args[0]) | taken("local") | RESERVED_LOCAL
    busy_ts = parse_busy(args[1]) | taken("ts") | RESERVED_TS
    def pick(start, busy):
        p = int(start)
        for _ in range(2000):
            if 1 <= p <= 65535 and p not in busy:
                return p
            p += 1
        print("no free port found within search window", file=sys.stderr)
        sys.exit(2)
    local_port = pick(reg["nextLocalPort"], busy_local)
    ts_port = pick(reg["nextTsPort"], busy_ts)
    print(f"{local_port} {ts_port}")

elif op == "commit":
    # commit <name> <localPort> <tsPort> <projectLimit> <admin> <tsLogin>
    # Persist a user AFTER its instance passed health checks. tsLogin may be
    # the empty string (stored as null).
    name, local_port, ts_port = args[0], int(args[1]), int(args[2])
    project_limit, admin = int(args[3]), args[4] == "true"
    ts_login = args[5] if len(args) > 5 and args[5] else None
    if name in reg["users"]:
        print(f"user '{name}' already present at commit time", file=sys.stderr)
        sys.exit(1)
    if local_port in RESERVED_LOCAL or ts_port in RESERVED_TS:
        print("refusing to commit reserved production port", file=sys.stderr)
        sys.exit(2)
    if ts_login and any(u.get("tsLogin") == ts_login for u in reg["users"].values()):
        print(f"tsLogin '{ts_login}' is already mapped to another user", file=sys.stderr)
        sys.exit(3)
    reg["users"][name] = {
        "localPort": local_port,
        "tsPort": ts_port,
        "baseDir": f"/home/dev/services/lateshift/users/{name}",
        "projectLimit": project_limit,
        "sharedAccess": False,
        "admin": admin,
        "tsLogin": ts_login,
        "monthlyBudgetUsd": 0,
        "sharedProjects": [],
        "createdAt": datetime.datetime.now(datetime.timezone.utc)
            .strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    reg["nextLocalPort"] = max(reg["nextLocalPort"], local_port + 1)
    reg["nextTsPort"] = max(reg["nextTsPort"], ts_port + 1)
    save()

elif op == "get":
    name, field = args[0], args[1]
    user = reg["users"].get(name)
    if user is None:
        sys.exit(1)
    print(user[field])

elif op == "remove":
    name = args[0]
    if name not in reg["users"]:
        sys.exit(1)
    del reg["users"][name]
    save()

elif op == "set":
    # set <name> <key> <value>
    # Allowed keys only; each value is validated here (defense in depth: the
    # bash wrapper validates too).
    name, key, value = args[0], args[1], args[2]
    user = reg["users"].get(name)
    if user is None:
        print(f"user '{name}' not found", file=sys.stderr)
        sys.exit(1)
    if key == "projectLimit":
        if not (value.isdigit() and 0 <= int(value) <= 999):
            print("projectLimit must be an integer 0-999", file=sys.stderr)
            sys.exit(2)
        user[key] = int(value)
    elif key in ("sharedAccess", "admin"):
        if value not in ("true", "false"):
            print(f"{key} must be 'true' or 'false'", file=sys.stderr)
            sys.exit(2)
        user[key] = value == "true"
    elif key == "tsLogin":
        import re
        if value == "":
            user[key] = None
        else:
            if not re.fullmatch(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+", value) or len(value) > 128:
                print(f"invalid tsLogin '{value}'", file=sys.stderr)
                sys.exit(2)
            for other, u in reg["users"].items():
                if other != name and u.get("tsLogin") == value:
                    print(f"tsLogin '{value}' is already mapped to user '{other}'", file=sys.stderr)
                    sys.exit(3)
            user[key] = value
    elif key == "monthlyBudgetUsd":
        try:
            n = float(value)
        except ValueError:
            print("monthlyBudgetUsd must be a number", file=sys.stderr)
            sys.exit(2)
        if not (0 <= n <= 100000):
            print("monthlyBudgetUsd must be 0-100000 (0 = unlimited)", file=sys.stderr)
            sys.exit(2)
        user[key] = round(n, 2)
    else:
        print(f"key '{key}' is not settable (allowed: projectLimit, sharedAccess, tsLogin, admin, monthlyBudgetUsd)", file=sys.stderr)
        sys.exit(2)
    save()

elif op == "share":
    # share <name> <abs-path> — record a shared project grant (idempotent).
    name, path = args[0], args[1]
    user = reg["users"].get(name)
    if user is None:
        print(f"user '{name}' not found", file=sys.stderr)
        sys.exit(1)
    shared = user.setdefault("sharedProjects", [])
    if path not in shared:
        shared.append(path)
        save()

elif op == "unshare":
    # unshare <name> <abs-path> — drop a shared project grant (idempotent).
    name, path = args[0], args[1]
    user = reg["users"].get(name)
    if user is None:
        print(f"user '{name}' not found", file=sys.stderr)
        sys.exit(1)
    shared = user.setdefault("sharedProjects", [])
    if path in shared:
        shared.remove(path)
        save()

elif op == "shares":
    # shares <name> — print grants one per line.
    user = reg["users"].get(args[0])
    if user is None:
        sys.exit(1)
    for p in user.get("sharedProjects", []):
        print(p)

elif op == "list":
    fmt = "{:<20} {:>9} {:>7} {:>13} {:>6} {:>6}  {:<28} {}"
    print(fmt.format("NAME", "LOCALPORT", "TSPORT", "PROJECTLIMIT", "SHARED", "ADMIN", "TSLOGIN", "CREATED"))
    for name, u in sorted(reg["users"].items()):
        print(fmt.format(name, u["localPort"], u["tsPort"], u["projectLimit"],
                         "yes" if u["sharedAccess"] else "no",
                         "yes" if u["admin"] else "no",
                         u.get("tsLogin") or "-", u["createdAt"]))

else:
    print(f"unknown registry op: {op}", file=sys.stderr)
    sys.exit(2)
PYEOF
}

# CSV of local TCP ports currently in LISTEN state.
listening_ports_csv() {
    ss -ltnH 2>/dev/null | awk '{print $4}' | awk -F: '{print $NF}' \
        | grep -E '^[0-9]+$' | sort -un | paste -sd, - || true
}

# CSV of HTTPS ports currently mapped by tailscale serve (443 implied when
# the URL carries no explicit port).
serve_ports_csv() {
    {
        tailscale serve status 2>/dev/null \
            | grep -oE '^https://[^ ]+' \
            | sed -E 's|^https://[^:/]+:?([0-9]*).*|\1|' \
            | sed 's/^$/443/'
    } | grep -E '^[0-9]+$' | sort -un | paste -sd, - || true
}

wait_for_health() {
    local name="$1" port="$2" deadline=$((SECONDS + HEALTH_TIMEOUT_SECS)) code
    while (( SECONDS < deadline )); do
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:${port}/" || true)
        if [[ "${code}" == "200" ]] && [[ "$(systemctl is-active "t3code@${name}.service" 2>/dev/null)" == "active" ]]; then
            echo "healthy (HTTP ${code} on 127.0.0.1:${port}, unit active)"
            return 0
        fi
        sleep 2
    done
    return 1
}

# Confirm the process listening on <port> belongs to the t3code@<name> unit's
# cgroup. Returns 0 on confirmed ownership, 0 with a warning if ownership
# cannot be determined (is-active + curl already passed), 1 on a confirmed
# foreign listener.
verify_unit_owns_port() {
    local name="$1" port="$2" listener_pid cgroup_procs
    listener_pid=$(ss -ltnpH "sport = :${port}" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1 || true)
    cgroup_procs="/sys/fs/cgroup/system.slice/system-t3code.slice/t3code@${name}.service/cgroup.procs"
    if [[ -z "${listener_pid}" || ! -r "${cgroup_procs}" ]]; then
        echo "warning: could not attribute listener on port ${port} to a cgroup; relying on is-active + HTTP checks" >&2
        return 0
    fi
    if grep -qx "${listener_pid}" "${cgroup_procs}"; then
        echo "listener pid ${listener_pid} confirmed inside t3code@${name}.service cgroup"
        return 0
    fi
    echo "port ${port} is served by pid ${listener_pid}, which is NOT in t3code@${name}.service's cgroup" >&2
    return 1
}

# Roll back a failed `add`: stop/disable the unit, clear its serve mapping,
# delete the directory this invocation created. The registry was never
# touched (commit happens only after health), so nothing to undo there.
rollback_add() {
    local name="$1" ts_port="$2" created_dir="$3"
    echo "rolling back failed provision of '${name}' ..." >&2
    sudo systemctl disable --now "t3code@${name}.service" >/dev/null 2>&1 || true
    if [[ -n "${ts_port}" ]] && (( ts_port != RESERVED_TS_PORT )); then
        sudo tailscale serve --https="${ts_port}" off 2>/dev/null || true
    fi
    # Safe: this exact path was verified absent at the start of this add and
    # created by this invocation; the instance never became healthy.
    if [[ -n "${created_dir}" && -d "${created_dir}" ]]; then
        rm -rf "${created_dir}"
    fi
}

cmd_add() {
    local name="" project_limit=3 admin=false ts_login=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project-limit) project_limit="${2:?--project-limit needs a value}"; shift 2 ;;
            --admin) admin=true; shift ;;
            --ts-login) ts_login="${2:?--ts-login needs a value}"; shift 2 ;;
            -*) die "unknown flag for add: $1" ;;
            *) [[ -n "${name}" ]] && die "unexpected argument: $1"; name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: t3user add <name> [--project-limit N] [--admin] [--ts-login LOGIN]"
    validate_name "${name}"
    [[ "${project_limit}" =~ ^[0-9]+$ ]] || die "--project-limit must be a number"
    [[ -n "${ts_login}" ]] && validate_ts_login "${ts_login}"

    if registry_py exists "${name}"; then
        die "user '${name}' already exists (refusing to re-add)"
    fi
    [[ -e "${USERS_DIR}/${name}" ]] && die "base dir ${USERS_DIR}/${name} already exists; resolve manually"

    # Allocate ports (no registry write yet; the held flock reserves the pair
    # for the duration of this add). Skips listening ports, existing registry
    # entries, live tailscale serve mappings, and production's 3773/443.
    local ports
    ports=$(registry_py alloc "$(listening_ports_csv)" "$(serve_ports_csv),$(listening_ports_csv)") \
        || die "port allocation failed"
    local local_port ts_port
    read -r local_port ts_port <<< "${ports}"
    local_port=$(normalize_port "${local_port}") || die "allocator returned bad local port"
    ts_port=$(normalize_port "${ts_port}") || die "allocator returned bad ts port"
    (( local_port != RESERVED_LOCAL_PORT )) || die "allocator returned reserved local port ${RESERVED_LOCAL_PORT}"
    (( ts_port != RESERVED_TS_PORT )) || die "allocator returned reserved HTTPS port ${RESERVED_TS_PORT}"

    local base_dir="${USERS_DIR}/${name}"
    mkdir -p "${base_dir}"
    cat > "${base_dir}/instance.env" <<EOF
# LateShift Cloud instance config for '${name}' (consumed by t3code@${name}.service)
T3CODE_INSTANCE_PORT=${local_port}
TS_SERVE_PORT=${ts_port}
T3CODE_MAX_PROJECTS=${project_limit}
EOF

    echo "provisioning '${name}': local port ${local_port}, tailnet HTTPS port ${ts_port}"
    if ! sudo systemctl enable --now "t3code@${name}.service"; then
        rollback_add "${name}" "${ts_port}" "${base_dir}"
        die "systemctl enable --now t3code@${name} failed; rolled back (registry untouched)"
    fi

    echo -n "waiting for health on 127.0.0.1:${local_port} ... "
    if ! wait_for_health "${name}" "${local_port}"; then
        echo "FAILED"
        echo "instance did not become healthy within ${HEALTH_TIMEOUT_SECS}s; recent logs:" >&2
        sudo journalctl -u "t3code@${name}" -n 20 --no-pager >&2 || true
        rollback_add "${name}" "${ts_port}" "${base_dir}"
        die "provision failed; rolled back (registry untouched)"
    fi
    if ! verify_unit_owns_port "${name}" "${local_port}"; then
        rollback_add "${name}" "${ts_port}" "${base_dir}"
        die "port ${local_port} answered but is not owned by t3code@${name}; rolled back (registry untouched)"
    fi

    # Instance is healthy and verified: persist it to the registry (atomic write).
    registry_py commit "${name}" "${local_port}" "${ts_port}" "${project_limit}" "${admin}" "${ts_login}" \
        || { rollback_add "${name}" "${ts_port}" "${base_dir}"; die "registry commit failed; rolled back"; }

    # Best-effort tailnet reachability check (warn only: tailscale serve can
    # lag a moment, and local health is the provisioning gate).
    local ts_code
    ts_code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://${TAILNET_HOST}:${ts_port}/" || true)
    if [[ "${ts_code}" != "200" ]]; then
        sleep 3
        ts_code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://${TAILNET_HOST}:${ts_port}/" || true)
    fi
    if [[ "${ts_code}" == "200" ]]; then
        echo "tailnet endpoint healthy (HTTP 200 on https://${TAILNET_HOST}:${ts_port}/)"
    else
        echo "warning: https://${TAILNET_HOST}:${ts_port}/ returned '${ts_code:-none}'; check 'tailscale serve status'" >&2
    fi

    systemctl status "t3code@${name}" --no-pager -n 0 | head -6 || true
    echo
    echo "user '${name}' is up:"
    echo "  local:   http://127.0.0.1:${local_port}/"
    echo "  tailnet: https://${TAILNET_HOST}:${ts_port}/"
    echo "  pair:    t3user pair ${name}"
}

cmd_remove() {
    local name="" force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force) force=true; shift ;;
            -*) die "unknown flag for remove: $1" ;;
            *) [[ -n "${name}" ]] && die "unexpected argument: $1"; name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: t3user remove <name> [--force]"
    validate_name "${name}"
    registry_py exists "${name}" || die "user '${name}' not found"

    local ts_port_raw ts_port=""
    ts_port_raw=$(registry_py get "${name}" tsPort)
    if ! ts_port=$(normalize_port "${ts_port_raw}"); then
        ${force} || die "registry tsPort '${ts_port_raw}' for '${name}' is invalid; refusing (use --force to skip serve cleanup)"
        echo "warning: invalid tsPort '${ts_port_raw}'; skipping tailscale serve cleanup" >&2
        ts_port=""
    fi

    echo "stopping and disabling t3code@${name} ..."
    if ! sudo systemctl disable --now "t3code@${name}.service"; then
        if ${force}; then
            echo "warning: 'systemctl disable --now t3code@${name}' failed; continuing due to --force" >&2
        else
            die "failed to stop/disable t3code@${name}; aborting before archive/deregister (use --force to override)"
        fi
    fi

    # Clear any residual failed state so a removed user leaves no unit debris.
    sudo systemctl reset-failed "t3code@${name}.service" 2>/dev/null || true

    # Clear the tailscale serve mapping this instance created. Numeric guard:
    # never touch production's HTTPS 443.
    if [[ -n "${ts_port}" ]] && (( ts_port != RESERVED_TS_PORT )); then
        sudo tailscale serve --https="${ts_port}" off 2>/dev/null || true
    fi

    if [[ -d "${USERS_DIR}/${name}" ]]; then
        # Collision-safe archive destination: UTC timestamp + nanoseconds, and
        # hard-fail if it somehow already exists (never merge/nest archives).
        local dest="${ARCHIVE_DIR}/${name}-$(date -u +%Y%m%d-%H%M%S)-$(date +%N)"
        [[ -e "${dest}" ]] && die "archive destination ${dest} already exists; refusing to overwrite"
        mv -T "${USERS_DIR}/${name}" "${dest}"
        echo "archived base dir to ${dest}"
    fi

    registry_py remove "${name}"
    echo "user '${name}' removed (data archived, never deleted)"
}

cmd_list() {
    [[ $# -eq 0 ]] || die "list takes no arguments"
    registry_py list
}

# set <name> <key> <value> — update one registry field. For projectLimit the
# instance.env T3CODE_MAX_PROJECTS line is rewritten too; the caller must
# restart t3code@<name> for the new limit to take effect.
cmd_set() {
    [[ $# -eq 3 ]] || die "usage: t3user set <name> <key> <value>"
    local name="$1" key="$2" value="$3"
    validate_name "${name}"
    registry_py exists "${name}" || die "user '${name}' not found"

    case "${key}" in
        projectLimit)
            [[ "${value}" =~ ^[0-9]{1,3}$ ]] || die "projectLimit must be an integer 0-999"
            ;;
        sharedAccess|admin)
            [[ "${value}" == "true" || "${value}" == "false" ]] || die "${key} must be 'true' or 'false'"
            ;;
        tsLogin)
            [[ -n "${value}" ]] && validate_ts_login "${value}"
            ;;
        monthlyBudgetUsd)
            [[ "${value}" =~ ^[0-9]+(\.[0-9]{1,2})?$ ]] || die "monthlyBudgetUsd must be a number (0 = unlimited)"
            ;;
        *) die "key '${key}' is not settable (allowed: projectLimit, sharedAccess, tsLogin, admin, monthlyBudgetUsd)" ;;
    esac

    registry_py set "${name}" "${key}" "${value}"

    if [[ "${key}" == "projectLimit" ]]; then
        local env_file
        env_file="$(registry_py get "${name}" baseDir)/instance.env"
        if [[ -f "${env_file}" ]]; then
            # Rewrite only the T3CODE_MAX_PROJECTS line; never touch the port
            # lines. Atomic replace within the same directory.
            local tmp
            tmp="$(mktemp "${env_file}.tmp.XXXXXX")"
            if grep -q '^T3CODE_MAX_PROJECTS=' "${env_file}"; then
                sed "s/^T3CODE_MAX_PROJECTS=.*/T3CODE_MAX_PROJECTS=${value}/" "${env_file}" > "${tmp}"
            else
                cat "${env_file}" > "${tmp}"
                echo "T3CODE_MAX_PROJECTS=${value}" >> "${tmp}"
            fi
            mv "${tmp}" "${env_file}"
            echo "updated ${env_file}; restart t3code@${name} to apply the new limit"
        else
            echo "warning: ${env_file} not found; registry updated but no instance.env to rewrite" >&2
        fi
    fi
    echo "set ${name}.${key} = ${value}"
}

# Validate a shared-project path: absolute, exists, and under an allowed root.
# Realpath resolution prevents symlink/.. escapes out of the allowed roots.
validate_shared_path() {
    local path="$1" real
    [[ "${path}" == /* ]] || die "shared project path must be absolute"
    real=$(realpath -e "${path}" 2>/dev/null) || die "path '${path}' does not exist"
    case "${real}" in
        /home/dev/shared/*|/home/dev/projects/*) ;;
        *) die "shared projects must live under /home/dev/shared/ or /home/dev/projects/ (got ${real})" ;;
    esac
    [[ -d "${real}" ]] || die "'${real}' is not a directory"
    echo "${real}"
}

cmd_share() {
    [[ $# -eq 2 ]] || die "usage: t3user share <name> <abs-path>"
    local name="$1" path real base_dir
    validate_name "${name}"
    registry_py exists "${name}" || die "user '${name}' not found"
    real=$(validate_shared_path "$2")
    base_dir=$(registry_py get "${name}" baseDir)

    "${T3_CLI}" project add "${real}" --base-dir "${base_dir}" \
        || die "t3 project add failed for '${real}' on ${name}'s instance"
    registry_py share "${name}" "${real}"
    echo "shared '${real}' with '${name}'"
}

cmd_unshare() {
    [[ $# -eq 2 ]] || die "usage: t3user unshare <name> <abs-path>"
    local name="$1" path real base_dir
    validate_name "${name}"
    registry_py exists "${name}" || die "user '${name}' not found"
    # Resolve without -e: the target dir may already be gone; fall back to raw.
    real=$(realpath -m "$2" 2>/dev/null || echo "$2")
    base_dir=$(registry_py get "${name}" baseDir)

    "${T3_CLI}" project remove "${real}" --base-dir "${base_dir}" \
        || echo "warning: t3 project remove failed (project may not be registered); clearing grant anyway" >&2
    registry_py unshare "${name}" "${real}"
    echo "unshared '${real}' from '${name}'"
}

cmd_pair() {
    local name="" ttl="1h"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ttl) ttl="${2:?--ttl needs a value}"; shift 2 ;;
            -*) die "unknown flag for pair: $1" ;;
            *) [[ -n "${name}" ]] && die "unexpected argument: $1"; name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: t3user pair <name> [--ttl 1h]"
    validate_name "${name}"
    registry_py exists "${name}" || die "user '${name}' not found"

    local base_dir ts_port
    base_dir=$(registry_py get "${name}" baseDir)
    ts_port=$(normalize_port "$(registry_py get "${name}" tsPort)") || die "registry tsPort for '${name}' is invalid"

    "${T3_CLI}" auth pairing create \
        --base-dir "${base_dir}" \
        --ttl "${ttl}" \
        --label "lateshift-${name}" \
        --base-url "https://${TAILNET_HOST}:${ts_port}"
}

main() {
    [[ $# -ge 1 ]] || usage 1
    local cmd="$1"; shift
    case "${cmd}" in
        add|remove|pair|list|set|share|unshare)
            # Serialize ALL registry access (reads included) across concurrent
            # invocations; lock is taken before first-time registry creation.
            mkdir -p "${LATESHIFT_ROOT}"
            exec 9> "${LOCK_FILE}"
            flock 9
            ensure_registry
            "cmd_${cmd}" "$@"
            ;;
        -h|--help|help) usage 0 ;;
        *) die "unknown command '${cmd}' (try: add, remove, list, set, pair)" ;;
    esac
}

main "$@"
