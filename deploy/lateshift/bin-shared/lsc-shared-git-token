#!/usr/bin/env bash
# lsc-shared-git-token [<token>]
#
# Install (or replace) the SHARED GitHub push token used by all LateShift Cloud
# shared repos under /home/dev/shared. The token is validated against GitHub and
# written atomically to the credential store with mode 600.
#
#   lsc-shared-git-token ghp_xxxxxxxxxxxxxxxx      # token as an argument
#   lsc-shared-git-token                           # prompt / read from stdin
#
# ============================ SECURITY TRADEOFF ==============================
# The credential store (/home/dev/shared/.lsc-git-credentials) lives in the
# world-of-sharers directory: /home/dev/shared is a ReadWritePath in EVERY
# user's sandbox, so ANY sharer's instance can READ this file and therefore the
# raw token. Whatever this token can do, every sharer can do.
#
# STRONGLY RECOMMENDED: use a GitHub FINE-GRAINED personal access token scoped
# to ONLY the specific shared repositories, granting only:
#     Repository permissions -> Contents: Read and write
#     Repository permissions -> Pull requests: Read and write
# Do NOT use a classic PAT, an org-wide token, or anything with account-wide
# scope here - a leak would expose far more than the shared repos.
# =============================================================================
set -euo pipefail

CRED_FILE="/home/dev/shared/.lsc-git-credentials"

die() { echo "lsc-shared-git-token: $*" >&2; exit 1; }

# Obtain the token from arg 1, or read it (hidden) from a TTY, or from stdin.
token="${1:-}"
if [[ -z "${token}" ]]; then
    if [[ -t 0 ]]; then
        read -rsp "Paste the shared GitHub token (input hidden): " token
        echo >&2
    else
        read -r token || true
    fi
fi
token="${token%$'\n'}"
[[ -n "${token}" ]] || die "no token provided"

# Validate: the token must authenticate to a real GitHub account.
echo "Validating token against api.github.com ..." >&2
code=$(curl -sS -o /tmp/lsc-git-token-check.$$ -w '%{http_code}' \
        -H "Authorization: Bearer ${token}" \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        https://api.github.com/user) \
    || { rm -f "/tmp/lsc-git-token-check.$$"; die "network error contacting api.github.com; nothing written"; }

if [[ "${code}" != "200" ]]; then
    rm -f "/tmp/lsc-git-token-check.$$"
    die "token REJECTED by GitHub (HTTP ${code}); credential store left unchanged"
fi

login=$(grep -oE '"login"[[:space:]]*:[[:space:]]*"[^"]+"' "/tmp/lsc-git-token-check.$$" \
        | head -1 | sed -E 's/.*"login"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
rm -f "/tmp/lsc-git-token-check.$$"
[[ -n "${login}" ]] || login="(unknown)"

# Write atomically with 600 in the same directory (same filesystem -> atomic mv).
umask 077
tmp=$(mktemp "${CRED_FILE}.XXXXXX") || die "could not create temp file next to ${CRED_FILE}"
printf 'https://x-access-token:%s@github.com\n' "${token}" > "${tmp}"
chmod 600 "${tmp}"
mv -f "${tmp}" "${CRED_FILE}"
# If run as root, keep ownership consistent with the shared dir (dev:dev).
if [[ "$(id -u)" -eq 0 ]]; then
    chown dev:dev "${CRED_FILE}" || true
fi

echo "Shared GitHub token installed to ${CRED_FILE} (mode 600)."
echo "It authenticates to GitHub as: ${login}"
echo
echo "REMINDER: every sharer's sandbox can read this token. Use a fine-grained"
echo "PAT limited to the shared repos (Contents + Pull requests: read/write) only."
