#!/usr/bin/env bash
# lsc-shared-git-setup <repo-dir>
#
# Apply the LateShift Cloud SHARED-repo git identity override to ONE repository.
#
# Shared checkouts under /home/dev/shared are opened as projects by MULTIPLE
# users' sandboxed T3 instances. Each instance normally carries its OWN GitHub
# identity (per-instance GIT_CONFIG_GLOBAL + gh credential helper set by
# run-instance.sh). By the owner's decision, commits/pushes in shared repos
# should instead all go out under the OWNER's identity (slitherylemur): the AI
# chat is visible to every sharer anyway, so per-person attribution there does
# not matter, and it means no teammate needs push rights to the owner's repos.
#
# This is achieved with LOCAL (per-repo) git config, which overrides the
# per-instance GIT_CONFIG_GLOBAL inside every user's sandbox:
#   * user.name / user.email  -> the owner's GitHub no-reply identity
#   * credential.helper        -> reset to ONLY the shared credential store,
#                                 so pushes authenticate with the shared owner
#                                 token regardless of who (if anyone) the
#                                 sandbox's gh CLI is logged in as.
#
# gh CLI inside instances stays per-user (it reads GH_CONFIG_DIR directly, not
# git's credential helpers) - that is intentional and unaffected.
#
# Idempotent: safe to re-run any number of times.
set -euo pipefail

# --- Owner identity (public data; NOT a secret) -------------------------------
# Derived from the public GitHub API: `curl https://api.github.com/users/slitherylemur`
# -> id 67226924. The no-reply address keeps the owner's email private while
# still linking commits to the account.
OWNER_LOGIN="slitherylemur"
OWNER_ID="67226924"
OWNER_EMAIL="${OWNER_ID}+${OWNER_LOGIN}@users.noreply.github.com"

# Shared credential store: git credential-store format, one line
#   https://x-access-token:<TOKEN>@github.com
# Every sharer's sandbox can read this file (see lsc-shared-git-token).
CRED_FILE="/home/dev/shared/.lsc-git-credentials"

die() { echo "lsc-shared-git-setup: $*" >&2; exit 1; }

[[ $# -eq 1 ]] || die "usage: lsc-shared-git-setup <repo-dir>"

real=$(realpath -e "$1" 2>/dev/null) || die "path '$1' does not exist"
[[ -d "${real}" ]] || die "'${real}' is not a directory"
git -C "${real}" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "'${real}' is not a git repository"

# Author identity (local config wins over the per-instance global).
git -C "${real}" config user.name  "${OWNER_LOGIN}"
git -C "${real}" config user.email "${OWNER_EMAIL}"

# Credential helper: reset the inherited helper list (an empty value clears ALL
# helpers accumulated from earlier config, including the per-instance gh helper)
# then add ONLY the shared store. This guarantees pushes use the shared owner
# token and never a sandbox user's personal gh token.
git -C "${real}" config --replace-all credential.helper ""
git -C "${real}" config --add         credential.helper "store --file=${CRED_FILE}"

echo "lsc-shared-git-setup: configured ${real}"
echo "  user.name         = ${OWNER_LOGIN}"
echo "  user.email        = ${OWNER_EMAIL}"
echo "  credential.helper = store --file=${CRED_FILE}"
if [[ ! -s "${CRED_FILE}" ]]; then
    echo "  NOTE: ${CRED_FILE} is empty - pushes will fail until the owner runs" >&2
    echo "        lsc-shared-git-token to install the shared push token." >&2
fi
