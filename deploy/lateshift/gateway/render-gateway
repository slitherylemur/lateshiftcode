#!/usr/bin/env python3
"""render-gateway — regenerate the per-user Caddy site blocks for the
LateShift Cloud public gateway from users.json, then reload Caddy.

Reads  /home/dev/services/lateshift/users.json
Writes /etc/caddy/lsc-users.caddy   (atomic, idempotent)
Then   systemctl reload caddy        (unless --no-reload)

Each active user gets a site block:

    <name>.lateshiftcloud.com {
        import lsc_gated <localPort>
    }

The `lsc_gated` snippet (forward_auth to the portal + reverse_proxy) is
defined in the main /etc/caddy/Caddyfile. This file only supplies the
host->port mapping, so it stays tiny and safe to regenerate.

Must run as root (writes /etc/caddy and reloads the caddy service). Safe on
an empty/missing registry (emits an empty managed file). Never touches the
production instance, tailnet serve, or any other service.
"""

import json
import os
import re
import subprocess
import sys
import tempfile

REGISTRY = "/home/dev/services/lateshift/users.json"
OUT = "/etc/caddy/lsc-users.caddy"
DOMAIN = "lateshiftcloud.com"

# Names that would collide with reserved/static host blocks in the main
# Caddyfile. Never emit a generated block for these.
RESERVED_HOSTS = {"www", "prod", "api"}

# Defensive: subdomain label must be DNS-safe and match validate_name in t3user.
NAME_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")


def load_users(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return {}
    except (ValueError, OSError) as exc:
        print(f"render-gateway: cannot read {path}: {exc}", file=sys.stderr)
        return None
    users = data.get("users")
    return users if isinstance(users, dict) else {}


def render(users):
    lines = [
        "# GENERATED by render-gateway from users.json — do not edit by hand.",
        "# Regenerate: sudo /home/dev/services/lateshift/bin/render-gateway",
        "",
    ]
    for name in sorted(users):
        info = users[name] or {}
        port = info.get("localPort")
        if not NAME_RE.match(name):
            print(f"render-gateway: skipping invalid user name {name!r}", file=sys.stderr)
            continue
        if name in RESERVED_HOSTS:
            print(f"render-gateway: skipping reserved host name {name!r}", file=sys.stderr)
            continue
        if not isinstance(port, int) or not (1 <= port <= 65535):
            print(f"render-gateway: skipping {name!r}: bad localPort {port!r}", file=sys.stderr)
            continue
        # http:// scheme so Caddy binds these on http_port (8880), not 443.
        lines.append(f"http://{name}.{DOMAIN} {{")
        # Strip attacker-supplied identity/ops headers before anything
        # else in the block (snippet lives in the main Caddyfile).
        lines.append("\timport lsc_strip_identity")
        lines.append(f"\timport lsc_gated {port}")
        lines.append("}")
        lines.append("")
    return "\n".join(lines) + "\n"


def atomic_write(path, content):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".lsc-users.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main(argv):
    no_reload = "--no-reload" in argv[1:]
    users = load_users(REGISTRY)
    if users is None:
        return 1  # unreadable registry: leave existing config untouched
    content = render(users)

    # Idempotent: skip write+reload when nothing changed.
    try:
        with open(OUT, "r", encoding="utf-8") as fh:
            if fh.read() == content:
                print(f"render-gateway: {OUT} already current ({len(users)} user(s))")
                return 0
    except FileNotFoundError:
        pass

    atomic_write(OUT, content)
    print(f"render-gateway: wrote {OUT} ({len(users)} user(s))")

    if no_reload:
        return 0
    try:
        subprocess.run(["systemctl", "reload", "caddy"], check=True)
        print("render-gateway: reloaded caddy")
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        print(f"render-gateway: WARNING caddy reload failed: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
